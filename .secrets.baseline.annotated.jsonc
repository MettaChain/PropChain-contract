// READ-ONLY ANNOTATED COPY of the detect-secrets baseline.
// Do NOT use this as the real baseline: it has comments, so it is not valid JSON.
// Keep editing and committing the original .secrets.baseline instead.
{
  "version": "1.4.0",                          // detect-secrets version that made this file
  "plugins_used": [                            // detectors that scan for each kind of secret
    { "name": "ArtifactoryDetector" },         // JFrog Artifactory credentials
    { "name": "AWSKeyDetector" },              // AWS access keys
    { "name": "AzureStorageKeyDetector" },     // Azure storage account keys
    {
      "name": "Base64HighEntropyString",       // random-looking base64 strings
      "limit": 4.5                             // entropy cutoff (higher = fewer, stricter matches)
    },
    { "name": "BasicAuthDetector" },           // passwords in URLs like https://user:pass@host
    { "name": "CloudantDetector" },            // IBM Cloudant credentials
    { "name": "DiscordBotTokenDetector" },     // Discord bot tokens
    { "name": "GitHubTokenDetector" },         // GitHub personal access tokens
    {
      "name": "HexHighEntropyString",          // random-looking hex strings
      "limit": 3.0                             // entropy cutoff for hex
    },
    { "name": "IbmCloudIamDetector" },         // IBM Cloud IAM keys
    { "name": "IbmCosHmacDetector" },          // IBM Cloud Object Storage keys
    { "name": "JwtTokenDetector" },            // JSON Web Tokens
    {
      "name": "KeywordDetector",               // flags words like password, secret, api_key
      "keyword_exclude": ""                    // regex of keywords to ignore (empty = none)
    },
    { "name": "MailchimpDetector" },           // Mailchimp API keys
    { "name": "NpmDetector" },                 // npm auth tokens
    { "name": "PrivateKeyDetector" },          // PEM private key blocks
    { "name": "SendGridDetector" },            // SendGrid API keys
    { "name": "SlackDetector" },               // Slack tokens and webhooks
    { "name": "SoftlayerDetector" },           // IBM Softlayer API keys
    { "name": "SquareOAuthDetector" },         // Square OAuth secrets
    { "name": "StripeDetector" },              // Stripe API keys
    { "name": "TwilioKeyDetector" }            // Twilio API keys
  ],
  "filters_used": [                            // filters that remove likely false positives
    { "path": "detect_secrets.filters.allowlist.is_line_allowlisted" },                      // skips lines marked "pragma: allowlist secret"
    {
      "path": "detect_secrets.filters.common.is_ignored_due_to_verification_policies",       // skips results by verification status
      "min_level": 2                                                                         // policy strictness level
    },
    { "path": "detect_secrets.filters.heuristic.is_indirect_reference" },                    // skips variable references like config[...]
    { "path": "detect_secrets.filters.heuristic.is_likely_id_string" },                      // skips strings that look like IDs
    { "path": "detect_secrets.filters.heuristic.is_lock_file" },                             // skips lock files (Cargo.lock, package-lock.json)
    { "path": "detect_secrets.filters.heuristic.is_not_alphanumeric_string" },               // skips strings with no letters or numbers
    { "path": "detect_secrets.filters.heuristic.is_potential_uuid" },                        // skips UUIDs
    { "path": "detect_secrets.filters.heuristic.is_prefixed_with_dollar_sign" },             // skips $VARIABLE placeholders
    { "path": "detect_secrets.filters.heuristic.is_sequential_string" },                     // skips things like "abcdef" or "123456"
    { "path": "detect_secrets.filters.heuristic.is_swagger_file" },                          // skips Swagger/OpenAPI files
    { "path": "detect_secrets.filters.heuristic.is_templated_secret" }                       // skips template placeholders like {{ secret }}
  ],
  "results": {                                 // everything the scan flagged, grouped by file
    // "is_secret": false on every entry means someone reviewed it and
    // marked it a false positive, so it won't fail the check again.
    // "hashed_secret" is a SHA-1 hash, so the real value is never stored here.
    "docker-compose.yml": [
      {
        "type": "Secret Keyword",              // matched a keyword like "password"
        "filename": "docker-compose.yml",
        "hashed_secret": "3fd126d0044349a396d456cd0236e83af899e7e3",   // same hash as the entry below = same value
        "is_verified": false,                  // not checked against a live service
        "is_secret": false,                    // reviewed: false positive
        "line_number": 42                      // line in the file (shifts if the file is edited)
      },
      {
        "type": "Basic Auth Credentials",      // looks like user:pass in a URL
        "filename": "docker-compose.yml",
        "hashed_secret": "3fd126d0044349a396d456cd0236e83af899e7e3",   // same value as line 42 (likely a dev password)
        "is_verified": false,
        "is_secret": false,
        "line_number": 68
      }
    ],
    "scripts/archive-events.sh": [
      {
        "type": "Basic Auth Credentials",      // looks like user:pass in a URL
        "filename": "scripts/archive-events.sh",
        "hashed_secret": "9d4e1e23bd5b727046a9e3b4b7db57bd8d6ee684",
        "is_verified": false,
        "is_secret": false,
        "line_number": 9
      }
    ],
    "scripts/test_accounts.rs": [              // three different strings flagged, likely test keys
      {
        "type": "Base64 High Entropy String",  // random-looking base64 text
        "filename": "scripts/test_accounts.rs",
        "hashed_secret": "b12e86602d4a3f5138f96fd8a03d267f5ba8f3b5",
        "is_verified": false,
