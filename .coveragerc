$path = "coverage.toml"
$content = @'
# Coverage Configuration for PropChain Contracts
#
# NOTE: this file uses coverage.py-style sections ([run], [report], ...).
# coverage.py is a Python tool, while the contracts here are Rust, so
# check that your coverage tool (e.g. cargo-tarpaulin or cargo-llvm-cov)
# actually reads this file.

[run]
# Folders to measure coverage for. Only code under "contracts" is counted.
source = ["contracts"]

# Files and folders to ignore, so they don't lower the coverage score.
omit = [
    "*/target/*",       # build output generated by cargo, not our code
    "*/tests/*",        # test files shouldn't be measured by themselves
    "*/test_utils.rs",  # shared test helper code
    "*/e2e_tests.rs",   # end-to-end tests
]

# Also measure branch coverage: checks both sides of every if/else and
# match, not just whether each line ran.
branch = true

# List the exact line numbers that no test reached in the report.
show_missing = true

# Number of decimal places in the coverage percentage (e.g. 95.25%).
precision = 2

[report]
# Lines matching these patterns are skipped when calculating coverage.
# Each entry is a regular expression. Most of these are Python-specific
# and will not match anything in Rust code.
exclude_lines = [
    "pragma: no cover",               # lets you mark a line as deliberately untested
    "def __repr__",                   # Python: debug string method
    "raise AssertionError",           # Python: code that should never be reached
    "raise NotImplementedError",      # Python: placeholder methods
    "if __name__ == .__main__.:",     # Python: script entry point (the dots match quote characters)
    "if TYPE_CHECKING:",              # Python: imports only used for type hints
    "if False:",                      # dead code that never runs
    "class .*\\bProtocol\\):",        # Python: Protocol (interface) class definitions
    "@(abc\\.)?abstractmethod",       # Python: abstract methods have no body to test
]

# Fail the coverage check if the total is below 95%.
# Useful in CI to stop untested code from being merged.
fail_under = 95

[html]
# Folder where the HTML coverage report is written.
directory = "coverage/html"

[xml]
# File path for the XML report (used by CI tools like Codecov).
output = "coverage/coverage.xml"
'@
Set-Content -Path $path -Value $content -Encoding utf8
Get-Content $path | Select-Object -First 8